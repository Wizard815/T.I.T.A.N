# Copy to .env next to docker-compose.yml.

# Shared by titan and titan-hands: openssl rand -hex 32
TITAN_HANDS_TOKEN=

# What titan-hands may touch. Names must match `docker ps` names.
#   faith:restart:logs   only restart and logs on faith
#   minecraft            start, restart and logs
TITAN_HANDS_CONTAINERS=faith:restart:logs LLMWIKI:restart immich:restart mealiev1:restart binhex-plexpass:restart Unraid-Cloudflared-Tunnel:state
# Sync jobs titan-hands may call (POST): name=url
TITAN_HANDS_SYNCS=

# Game servers in AMP. Make an AMP user just for this, with permission to
# start and restart only these instances. Names are AMP instance or friendly names.
TITAN_HANDS_AMP_URL=http://192.168.20.5:8080
TITAN_HANDS_AMP_USER=titan
TITAN_HANDS_AMP_PASSWORD=
TITAN_HANDS_AMP_INSTANCES=Enshrouded01
# 0 stops titan listing containers for discover: (names, state, ports, a few labels only)
TITAN_HANDS_DISCOVER=1

# The first owner account, made on first start when there are no accounts.
TITAN_FIRST_OWNER=wizard
TITAN_FIRST_PASSWORD=

# Overseer reads GET /api/events with this as a Bearer token: openssl rand -hex 32
TITAN_EXPORT_TOKEN=

# Read-only API keys for the extra card info (titan only, never shown).
TAUTULLI_API_KEY=
SEERR_API_KEY=
SONARR_API_KEY=
RADARR_API_KEY=
SABNZBD_API_KEY=
RADARR_API_KEY=

# Shown to people as who gets their messages.
TITAN_OWNER_LABEL=Wizard
# Set to 1 when T.I.T.A.N is behind HTTPS (a reverse proxy).
TITAN_SECURE_COOKIE=0
# ARGOS_API_KEY=   only if argos.api_key_env is set
