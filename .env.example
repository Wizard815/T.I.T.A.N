# Copy to .env next to docker-compose.yml.

# Shared by titan and titan-hands: openssl rand -hex 32
TITAN_HANDS_TOKEN=

# What titan-hands may touch. Names must match `docker ps` names.
#   faith:restart:logs   only restart and logs on faith
#   minecraft            start, restart and logs
TITAN_HANDS_CONTAINERS=AMP:state faith:restart:logs LLMWIKI:restart immich:restart mealiev1:restart binhex-plexpass:restart Unraid-Cloudflared-Tunnel:state
# Sync jobs titan-hands may call (POST): name=url
TITAN_HANDS_SYNCS=

# The first owner account, made on first start when there are no accounts.
TITAN_FIRST_OWNER=wizard
TITAN_FIRST_PASSWORD=

# Overseer reads GET /api/events with this as a Bearer token: openssl rand -hex 32
TITAN_EXPORT_TOKEN=

# Shown to people as who gets their messages.
TITAN_OWNER_LABEL=Wizard
# Set to 1 when T.I.T.A.N is behind HTTPS (a reverse proxy).
TITAN_SECURE_COOKIE=0
# ARGOS_API_KEY=   only if argos.api_key_env is set
